# Mirrors forensic-rs's own .github/workflows/rust.yml, updated to current
# non-deprecated actions (actions-rs/toolchain is archived; actions/checkout@v2
# is outdated). Place at .github/workflows/rust.yml in the new repo.
name: Rust

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
    - uses: actions/checkout@v4

    - name: Set up Rust
      uses: dtolnay/rust-toolchain@stable

    - name: Run tests
      run: cargo test --verbose
